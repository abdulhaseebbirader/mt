# ── Restaurant Reconcile & Inventory Hub — environment variables ──────────────
# Copy these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Values come from the Lovable project's Secrets.

# Lovable AI/connector gateway key — server-only, used to call the
# Google Sheets connector from server functions.
LOVABLE_API_KEY=

# Encrypted project key for the connected Google Sheets account
# (created when the Google Sheets connector was linked to this project).
GOOGLE_SHEETS_API_KEY=

# Per-branch Google Spreadsheet IDs (one spreadsheet per branch,
# each with a SALES and an INVENTORY tab).
AZAD_SPREADSHEET_ID=
ROSHAN_SPREADSHEET_ID=
